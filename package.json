{
  "name": "dsh-thinking-language",
  "version": "2.0.1",
  "description": "DSH plugin: switch the language of the agent's thinking/reasoning process (简体中文, 繁體中文, English, Русский, Français, Deutsch, Español, العربية, Português, 日本語)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qingmomo233/dsh-thinking-language.git"
  },
  "homepage": "https://github.com/qingmomo233/dsh-thinking-language",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "thinking",
    "reasoning",
    "chain-of-thought",
    "language",
    "locale"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./dshlatking.png",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "scripts",
    "cordis.patch.yml",
    "dshlatking.png",
    "CHANGELOG.md",
    "README.md",
    "README.en.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "scripts": {
    "test": "node smoke-test.mjs && node cordis-check.mjs",
    "test:smoke": "node smoke-test.mjs",
    "test:cordis": "node cordis-check.mjs",
    "patch:apiproxy": "node scripts/patch-apiproxy.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.2-rc.1 <0.3.0-0",
      "dshReleases": {
        "0.2.2-rc.1": "compatible"
      }
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1"
  }
}
