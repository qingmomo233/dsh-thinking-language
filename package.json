{
  "name": "dsh-thinking-language",
  "version": "1.2.0",
  "description": "DSH plugin: switch the language of the agent's thinking/reasoning process (简体中文, English, Русский, Français, Deutsch, Español, 日本語, 한국어 and more)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qingmomo233/dsh-thinking-language.git"
  },
  "homepage": "https://github.com/qingmomo233/dsh-thinking-language",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "thinking",
    "reasoning",
    "chain-of-thought",
    "language",
    "locale"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "test": "node smoke-test.mjs && node cordis-check.mjs",
    "test:smoke": "node smoke-test.mjs",
    "test:cordis": "node cordis-check.mjs",
    "patch:apiproxy": "node scripts/patch-apiproxy.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "external": [
        "react",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    }
  }
}
